# 로컬 개발용 기본값. docker-compose.yml의 서비스와 일치한다.
# 실제 시크릿은 여기에 넣지 않는다 (보안 문서 6장).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prs
POSTGRES_USER=prs
POSTGRES_PASSWORD=prs

ELASTICSEARCH_NODE=http://localhost:9200
# ELASTICSEARCH_API_KEY=   # 운영에서만. local 컴포즈는 보안 비활성

REDIS_URL=redis://localhost:6379
# 끊겼을 때 빨리 실패해 아웃박스(JOB-ING-007)에 맡기기 위한 값들 (ADR-002 follow-up).
# REDIS_MAX_RETRIES=1
# REDIS_CONNECT_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=1000
# 토픽별 파티션 수 덮어쓰기. 비동기 문서 2장의 동시성 값이 기본이다.
# PRS_PARTITIONS_prs:sequence=8

# 웹훅 수신 (WP-004). 실제 값은 여기 두지 않는다 — 운영은 Kubernetes Secret이다.
GHE_WEBHOOK_SECRET=local-dev-webhook-secret
# 시크릿 회전 중에만 채운다. 구·신 두 값으로 모두 검증한다 (보안 문서 6장).
# GHE_WEBHOOK_SECRET_PREVIOUS=
# NDJSON 원본 아카이브 경로 (ADR-002 레인 B). 빈 값이면 아카이브를 끈다.
INGEST_ARCHIVE_PATH=./var/archive/raw-events.ndjson
# 큐 발행 마감(ms). 넘기면 발행을 포기하고 아웃박스에 맡긴다 (NFR-002).
INGEST_ENQUEUE_TIMEOUT_MS=150

# 워커가 맡을 역할 (시스템 아키텍처 4장). 쉼표로 나눈다.
PIPELINE_WORKER_ROLES=batch

# 앱 포트 (인프라 8장)
INGEST_GATEWAY_PORT=3001
SEARCH_API_PORT=3002
PIPELINE_WORKER_PORT=3003
WEB_PORT=3000

# Regression Atlas first UI slice (both are explicit opt-ins; no live MDVP adapter).
# NEXT_PUBLIC value is captured by next build; rebuild when changing it.
NEXT_PUBLIC_REGRESSION_ENABLED=0
REGRESSION_FIXTURE_ENABLED=0
