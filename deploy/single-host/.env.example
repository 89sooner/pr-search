# PR Search — 단일 호스트 운영 구성 (WP-070 / CR-059).
#
# **이 파일을 복사해 `.env`를 만든 뒤 값을 채운다.** 값이 채워진 파일은
# **저장소에도 어떤 오프라인 번들에도 들어가지 않는다** (보안 문서 6장, DEV-499) —
# 사내 시크릿 관리에서 주입하고 소유자만 읽도록 권한을 좁힌다.
#
#   chmod 600 .env
#
# `?:`로 표시된 값은 **없으면 기동하지 않는다.** 조용히 기본값으로 도는 것보다
# 배포가 잘못됐음을 말하는 편이 낫다.

# ─────────────────────────────────────────────────────────────
# 릴리스 신원 — `latest`를 쓰지 않는다 (DEV-491)
# ─────────────────────────────────────────────────────────────
# 반입한 번들의 `release-manifest.json`이 적은 값을 그대로 넣는다.
PRS_VERSION=

# ─────────────────────────────────────────────────────────────
# 노출 — 사용자 접점 둘만 호스트에 발행한다 (인프라 6장)
# ─────────────────────────────────────────────────────────────
# 리버스 프록시를 두지 않는 형상에서는 0.0.0.0이 사내망 전체에 열린다.
# 프록시나 방화벽이 앞에 있으면 127.0.0.1로 좁힌다.
WEB_BIND=0.0.0.0
# **호스트에 이미 3000을 쓰는 것이 있는지 본다.** 첫 반입에서 감시 대시보드와
# 부딪혀 3010으로 옮겼다 — 이 값과 `.env`만 고치면 되며 코드는 건드리지 않는다.
WEB_PORT=3000
INGEST_BIND=0.0.0.0
INGEST_GATEWAY_PORT=3001

# ─────────────────────────────────────────────────────────────
# PostgreSQL — 주체를 둘로 나눈다 (마이그레이션 005)
# ─────────────────────────────────────────────────────────────
# 소유자: 마이그레이션이 DDL을 실행하는 주체.
POSTGRES_DB=prs
POSTGRES_OWNER_USER=prs
POSTGRES_OWNER_PASSWORD=

# 애플리케이션: DDL 권한이 없다. **감사 기록 불변성의 방어선이다** (FR-AUTH-004 AC-3).
#
# **`prs_app`을 그대로 쓰지 마라** (DEV-503). 그것은 마이그레이션 005가 만든
# `NOLOGIN` 그룹 롤이라 접속 자체가 거부된다. 로그인 가능한 주체를 만들고
# 멤버십을 준 뒤 **세션 기본 역할**을 그 롤로 둔다:
#
#   CREATE ROLE prs_app_login LOGIN PASSWORD :secret IN ROLE prs_app;
#   ALTER ROLE prs_app_login SET role = 'prs_app';
#
# 접속하면 `current_user = prs_app`이 된다. **소유자 계정을 그대로 쓰지 않는다** —
# 그 계정은 전권을 가져 감사 기록 불변성을 우회한다.
POSTGRES_APP_USER=prs_app_login
POSTGRES_APP_PASSWORD=

# `JOB-AUD-001` 파티션 수명 전용 (WP-039 / DEV-416).
# **`prs_admin`으로 직접 접속하지 않는다** — 그것은 `NOLOGIN` 그룹 롤이다.
# 로그인 가능한 주체가 멤버십을 받고, 잡이 그 위에서 `SET ROLE prs_admin`을 건다.
# **필수 값이다** (DEV-556). `require_env`가 요구하며 비어 있으면 `load`부터 멈춘다.
#
# **첫 반입에서 그 대가를 치렀다** (2026-09-07, DEV-553). 이 값이 비어 파티션 잡이
# 서지 않았고, `raw_event`에 파티션이 하나도 없어 **모든 웹훅이 `store_failed`로
# 떨어졌다.** 수신은 되는데 저장이 안 되는 모양이라 방화벽·서명 문제로 오진하기
# 쉽다. 그때의 처방은 이 주석이었는데 **주석은 강제하지 않는다** — 그래서 필수
# 목록으로 옮겼다.
#
# **롤은 `install`·`upgrade`·`restore`가 만든다.** 접속 주체와 같은 자리이며,
# 여기 적은 비밀번호가 그대로 롤의 비밀번호가 된다. 퍼센트 인코딩은 쓰지 않는다 —
# 앱이 디코딩한 값으로 접속해 인증에 실패한다. 자세한 것은 런북 2.B 「파티션 수명
# 주체」.
#   예: postgresql://prs_retention:<비밀번호>@postgres:5432/prs
ADMIN_DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Elasticsearch — 파일럿은 single-node다 (CR-059)
# ─────────────────────────────────────────────────────────────
# 힙은 호스트 RAM의 절반 이하, 31GB 이하로 둔다.
ES_JAVA_OPTS=-Xms2g -Xmx2g

# ─────────────────────────────────────────────────────────────
# GitHub Enterprise
# ─────────────────────────────────────────────────────────────
GHE_BASE_URL=
# REST 진입점이 `<base>/api/v3`와 다르면 채운다. **비워 두면 그 기본값을 쓴다** —
# 표준 GHE라면 채우지 않아도 된다 (DEV-548 이전에는 빈 값이 그대로 URL이 되어
# 설치 토큰 발급이 `Failed to parse URL`로 죽었다).
GHE_API_URL=
# 없으면 `enrich`·`reconcile` 역할이 **기동을 거부한다.** search-api는 뜨되
# API-ADM-007을 등록하지 않고 기동 로그가 그 사실을 밝힌다 (DEV-177).
GHE_APP_ID=
# 개행은 `\n`으로 이스케이프해 한 줄로 넣는다.
GHE_APP_PRIVATE_KEY=
# `org:installationId` 쉼표 구분 (DEV-015).
GHE_INSTALLATIONS=
# 없으면 모든 웹훅이 401이다.
GHE_WEBHOOK_SECRET=
# 회전 중에만 채운다. 구·신 두 값으로 모두 검증한다.
GHE_WEBHOOK_SECRET_PREVIOUS=

# ─────────────────────────────────────────────────────────────
# 인증 (OIDC)
# ─────────────────────────────────────────────────────────────
# **true로 두면 구성한 공급자의 자격 증명이 반드시 채워져야 한다** (`DEV-579`).
# `AUTH_PROVIDER=oidc`(기본)면 `OIDC_ISSUER`·`OIDC_CLIENT_ID`·
# `OIDC_CLIENT_SECRET`·`OIDC_REDIRECT_URI` 넷이고, `AUTH_PROVIDER=github`면
# `GHE_BASE_URL`·`GHE_OAUTH_CLIENT_ID`·`GHE_OAUTH_CLIENT_SECRET`·
# `GHE_OAUTH_REDIRECT_URI` 넷이다. 하나라도 비면 web이 기동하지 않는다.
# 인증을 아직 붙이지 않으려면 이 값을 `false`로 한다.
AUTH_ENABLED=true

# 어느 방식으로 로그인하는가 (`CR-083`).
#   oidc    (기본) 사내 표준 OIDC IdP. JWT 서명과 JWKS를 검증한다.
#   github  사내 GHE 계정으로 직접 로그인한다. **별도 IdP가 없을 때 쓴다** —
#           사내 GHE는 OIDC 디스커버리를 제공하지 않으므로 위 방식으로는 붙지
#           않는다. 아래 「사내 GHE 직접 로그인」 절을 함께 채운다.
# 값을 비우면 `oidc`다. 모르는 값을 주면 web이 기동하지 않는다 — 오타가
# 조용히 기본값으로 떨어지면 "GHE로 설정했는데 왜 OIDC 화면이 뜨지"가 된다.
AUTH_PROVIDER=oidc
# **운영에서 false를 주면 web이 기동하지 않는다** (FR-AUTH-001 AC-2, DEV-577).
# 평문 HTTP로 세션 쿠키를 내보내는 배포를 세우지 않겠다는 계약이며, `web`
# 컨테이너가 기동 시점에 이 값을 확인하고 종료한다 — 잘못된 값으로 올리면
# `docker compose ps`에 재기동이 보이고 `docker logs`에 이유가 남는다.
#
# **면제는 둘이다.** 둘 다 운영자가 **적어 낸** 선언에만 걸린다.
#
# 1. `AUTH_ENABLED=false`를 **명시한** 배포 (`CR-083`). 그 형상에서는 로그인 경로가
#    503을 내고 세션이 아예 발급되지 않으므로 보호할 쿠키가 없다. 화면은 서지만
#    **조회는 전부 401이다** — 관리 토큰으로 `/admin/*`을 쓰는 반입 검증용이다.
#    `AUTH_ENABLED`를 적지 않은 배포는 면제되지 않는다 — 자격 증명을 나중에 채우는
#    순간 인증이 켜지기 때문이다.
# 2. 아래 `ALLOW_INSECURE_COOKIES=true`를 **함께 적은** 배포 (`CR-091`). TLS 없이
#    로그인까지 시험해야 하는 **파일럿 전용**이다. 같은 망의 누구든 평문 HTTP에서
#    세션 쿠키를 가로챌 수 있다는 위험을 받아들이는 선언이며, web이 기동할 때마다
#    그 사실을 경고하고 `prsctl health`도 한 줄로 말한다.
#
# 운영 배포의 답은 TLS다. TLS를 붙이면 이 값을 true로 되돌리고 아래 플래그를 지운다.
SESSION_COOKIE_SECURE=true
# 평문 HTTP 파일럿에서 **인증을 켠 채** 세션을 발급한다 (`CR-091`). `true`만 켠다.
# 이 값만 적어서는 아무것도 바뀌지 않는다 — 위 `SESSION_COOKIE_SECURE`를 **함께**
# 바꿔야 한다. 한 줄의 실수로 평문 세션이 시작되지 않게 두 값을 요구한다.
# `true`·`false`·빈 값 밖의 값(`TRUE`·`yes`)은 web이 기동하지 않는다.
ALLOW_INSECURE_COOKIES=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 브라우저가 IdP에서 돌아올 주소 — `<서비스 주소>/auth/callback`이다.
# IdP에 등록한 값과 **문자 그대로 같아야** 한다. `AUTH_ENABLED=true`인데 이 값이
# 비면 web이 기동하지 않는다 (`DEV-579`). 비우는 것은 `AUTH_ENABLED=false`일 때만이다.
OIDC_REDIRECT_URI=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
# `그룹:역할` 쌍을 쉼표로 잇는다 — 구분자는 **콜론**이다 (`DEV-612`).
# 예: `platform-managers:manager,qa-team:qa`
# **부여할 수 있는 역할은 `manager`와 `qa` 둘뿐이다** (CR-015, DEV-049).
# `release_manager`·`operator`·`security_officer`는 관리자가 직접 지정하며,
# 여기 적으면 web이 기동하지 않는다 — 그룹을 만들 수 있는 사람이 운영 권한을
# 발급하게 두지 않는다. 모든 인증 사용자는 `developer`를 기본으로 받는다.
OIDC_GROUP_ROLE_MAP=

# ─────────────────────────────────────────────────────────────
# 사내 GHE 직접 로그인 (`AUTH_PROVIDER=github`일 때만, `CR-083`)
# ─────────────────────────────────────────────────────────────
# 위 OIDC 값 대신 이 절을 채운다. 사내 GHE의 OAuth2 Authorization Code Flow를
# 직접 쓰므로 Dex 같은 미들웨어를 따로 세우지 않아도 된다.
#
# **로그인용 OAuth App을 GHE에 새로 등록한다.** 수집용 GitHub App
# (`GHE_APP_ID`)과 **자격을 공유하지 않는다** — 하나가 유출됐을 때 피해 범위가
# 달라진다 (`ADR-022`의 근거와 같다). Authorization callback URL에는 아래
# `GHE_OAUTH_REDIRECT_URI`와 문자 그대로 같은 값을 넣는다.
#
# `GHE_BASE_URL`과 `GHE_API_URL`은 수집 경로가 쓰는 것과 같은 값이다(위쪽
# 「GitHub Enterprise」 절). 그 값이 web 컨테이너에도 전달된다.
GHE_OAUTH_CLIENT_ID=
GHE_OAUTH_CLIENT_SECRET=
# `<서비스 주소>/auth/callback` — OIDC 쪽과 같은 경로이고 같은 함정이다.
# `AUTH_PROVIDER=github`이고 `AUTH_ENABLED=true`인데 비면 web이 기동하지 않는다.
GHE_OAUTH_REDIRECT_URI=
# 비우면 `read:user read:org`다. **그것이 최소 권한이다** — `/user`에
# `read:user`, `/user/teams`에 `read:org`가 필요하다. 이메일까지 받으려면
# `user:email`을 더한다. 저장소 내용을 읽는 스코프는 필요 없다.
GHE_OAUTH_SCOPES=
# `<org>/<team>:<역할>` 쌍을 쉼표로 잇는다.
# 예: `cpswdev-team/pipe-admins:manager,cpswdev-team/pipe-users:qa`
# **위 `OIDC_GROUP_ROLE_MAP`과 형식·제약이 같다** — 부여할 수 있는 역할은
# `manager`와 `qa` 둘뿐이고, 비워 두면 모든 사용자가 `developer`만 받는다.
GHE_TEAM_ROLE_MAP=

# ─────────────────────────────────────────────────────────────
# 검색
# ─────────────────────────────────────────────────────────────
# **없으면 기동하지 않는다** (ADR-010 Amendment). 최소 32자.
# 서명 없는 커서를 발급하는 대신 배포가 잘못됐음을 말한다 — 커서가 조용히
# 사라지면 사용자는 5만 건 구간을 끝까지 훑을 방법이 없어지는데, 그 실패는
# 오류가 아니라 "결과가 이게 전부"로 보인다.
SEARCH_CURSOR_HMAC_KEY=

# 지표 저장소 되질의 (DEV-029). 없으면 단계별 지연 항목만 `unavailable`이다.
METRICS_QUERY_URL=

# ─────────────────────────────────────────────────────────────
# 관리 API
# ─────────────────────────────────────────────────────────────
# `이름:토큰` 쌍을 쉼표로 잇는다. **이름이 감사 기록의 주체가 되므로 사람마다
# 다른 값을 준다** — 하나를 공유하면 "누가 했는가"에 답할 수 없다 (DEV-030).
#
# **세션 인증(`AUTH_ENABLED=true`)과 함께 구성할 수 없다** (DEV-048). 둘 다 있으면
# search-api가 기동을 거부한다 — 세션 옆에 토큰 우회를 열어 둔 배포를 만들지 않는다.
# `prsctl`이 `load`·`install`·`upgrade`·`health` 전에 이 충돌을 먼저 막는다 (`CR-091`).
# **인증을 켜는 날 이 값을 비운다.** 그 뒤 관리 API의 통제는 `operator` 역할이며,
# 그 역할은 `./prsctl role grant <login> operator`로 준다(런북 6장).
#
# 값이 있으면 `prsctl smoke`가 이 토큰으로 **실제 조회 왕복**을 검증한다.
ADMIN_API_TOKENS=

# ─────────────────────────────────────────────────────────────
# 수집·워커
# ─────────────────────────────────────────────────────────────
INGEST_SHUTDOWN_GRACE_MS=30000
INGEST_ENQUEUE_TIMEOUT_MS=150
# 곱한 값이 아카이브 볼륨 용량보다 작아야 한다 (FR-ING-010 AC-7).
INGEST_ARCHIVE_MAX_BYTES=67108864
INGEST_ARCHIVE_KEEP=5
BACKFILL_MAX_CONCURRENCY=2

# `prsctl restore`가 별칭 하나의 재색인을 기다리는 상한(초). 재색인은 전역 동시
# 실행 상한이 1이라 넷을 **하나씩** 돌리므로, 저장소가 크면 늘린다 (DEV-519).
# 셸에 같은 이름을 export하면 그 값이 이 파일보다 우선한다 (DEV-520).
# 1 이상 2592000(30일) 이하의 정수다 — 넘치는 값은 산술이 음수로 돌아 0초처럼 동작한다 (DEV-521).
PRS_REINDEX_TIMEOUT_S=3600
# blob 지연 인출 허용 여부 (OD-001 / DEV-111). 기본은 차단이다.
MIRROR_ALLOW_BLOB_FETCH=false

# ─────────────────────────────────────────────────────────────
# M 번호 (WP-074 / FR-SEQ-008)
# ─────────────────────────────────────────────────────────────
# **셋이 같은 값이어야 한다** — `web`·`search-api`·`worker-sequence`가 이 하나를 함께 읽는다.
# API만 켜면 화면이 영원히 "M 번호 대기"를 보이고, 워커만 켜면 번호가 붙어도 화면에
# 나오지 않는다. `true`만 켜며 그 밖의 값은 기동을 거부한다.
#
# **끄고 반입해도 안전하다.** 꺼진 상태에서 목록·상세·범위 응답은 기존 모양 그대로이고
# `API-SEQ-007`은 404(`feature_disabled`)다. 채번 전 미러 fetch(`DEV-576` 수정)는 이 값과
# 무관하게 언제나 돈다.
#
# **M 코드가 도는 세 역할에 같은 값을 준다** — `search-api`(응답에 키를 만든다),
# `worker-sequence`(채번한다), `worker-batch`(**재색인이 여기서 돈다**, DEV-606).
# 하나라도 빠지면 그 역할만 꺼진 배포가 되고 오류도 로그도 없이 조용히 그렇게 된다.
#
# **`web`에는 주지 않는다** (DEV-589) — 화면은 응답에 M 키가 있는지로만 판단한다.
MNUMBER_ENABLED=false
# 한 회차가 확인하는 서수 수 (1..1000)와 durable work poll 간격(ms, 100..60000).
MNUMBER_BATCH_SIZE=100
MNUMBER_POLL_MS=1000

# `sequence` 역할이 first-parent 체인을 어디서 읽는가 (WP-074 / DEV-576).
#   mirror — 채번 **전에** 미러를 fetch한다. Profile A의 기본이며 미러 볼륨이 필요하다.
#   api    — 미러 없이 GHE REST로 head를 다시 읽는다 (Profile B).
# `mirror`인데 볼륨이 없으면 워커가 기동하지 않는다. 저장소별 `mirror_enabled=false`는
# 어느 모드에서도 API 경로다.
SEQUENCE_GRAPH_MODE=mirror

# ─────────────────────────────────────────────────────────────
# PR 제목 M 넘버 표기 (WP-075 / JOB-SEQ-005, FR-SEQ-009)
# ─────────────────────────────────────────────────────────────
#
# **이 제품이 사람의 지시 없이 GHE를 고치는 유일한 경로다** (ADR-022). 켜면 채번이
# 끝난 PR의 제목이 `[M-1900-1] <원래 제목>`으로 바뀐다. 원래 제목은 그대로 두고
# 접두만 앞에 붙으며, 이미 다른 M 넘버 접두가 있으면 **덮어쓰지 않고** 불일치로
# 기록한다.
#
# **기본은 꺼짐이다.** 위 `MNUMBER_ENABLED`(채번)와 **다른 값이다** — 번호는 보되
# 제목은 아직 건드리지 않는 형상이 정상이며, 반입의 첫 단계로 권한다. 이 값을
# 켜기 전에 GHE 목록과 알림에 제목 변경이 나간다는 것을 관련자에게 알린다.
#
# **켜 놓고 아래 자격이 비어 있으면 `worker-annotate`가 기동을 거부한다.** 조용히
# 꺼진 채 돌면 운영자가 켰다고 믿는 쓰기가 일어나지 않고 그것을 알 신호도 없다.
MNUMBER_ANNOTATE_ENABLED=false

# **표기 전용 GitHub App을 GHE에 새로 등록한다.** 수집용 App(`GHE_APP_ID`)과
# **자격을 공유하지 않는다** — 하나가 유출됐을 때 피해 범위가 달라진다
# (`FR-SEQ-009` AC-5, `THR-047`). 권한 반경은 **`Pull requests: write` 하나**이며
# 공식 문서가 제목 갱신 엔드포인트에 요구하는 권한이 그것뿐이다. 표기할 저장소에만
# 설치한다.
#
# `GHE_BASE_URL`·`GHE_API_URL`은 수집 경로가 쓰는 것과 같은 값이다(위쪽 「GitHub
# Enterprise」 절). 호스트 주소는 자격이 아니므로 공유해도 된다.
GHE_ANNOTATE_APP_ID=
# 개행은 `\n`으로 이스케이프해 한 줄로 넣는다.
GHE_ANNOTATE_PRIVATE_KEY=
# `org:installationId` 쉼표 구분. 수집용 `GHE_INSTALLATIONS`와 **다른 값이다** —
# 설치가 다르면 설치 ID도 다르다.
GHE_ANNOTATE_INSTALLATIONS=

# 미표기 잔여 스윕 간격(ms, 60000..604800000)과 한 회차 상한(1..5000).
# 스윕은 이벤트가 유실됐거나 쓰기 직후 프로세스가 죽어 결과를 못 남긴 행을 메운다.
MNUMBER_ANNOTATE_SWEEP_MS=86400000
MNUMBER_ANNOTATE_SWEEP_LIMIT=200
# 권한 오류(403·404)로 멈춘 저장소를 다시 보기까지의 시간(ms, 60000..2592000000).
# 운영자가 적어 낸 저장소별 해제 값은 이 차단과 **별개이며 바뀌지 않는다.**
MNUMBER_ANNOTATE_BLOCK_COOLDOWN_MS=86400000
# GHE 요청 시간 제한(ms, 1000..30000).
GHE_ANNOTATE_REQUEST_TIMEOUT_MS=10000
# 실제로 쓴 뒤 다음 쓰기까지의 간격(ms). **1000 아래로 내릴 수 없다** — 공식 문서가
# 「변경 요청 사이에 최소 1초를 기다리고 직렬로 보내라」고 정하며, 한도에 걸린 채
# 계속 요청하면 integration이 차단될 수 있다고 경고한다.
MNUMBER_ANNOTATE_WRITE_SPACING_MS=1000

# ─────────────────────────────────────────────────────────────
# GitHub Operations Plane — 웹에서 gh 실행 (REL-007 R0 / WP-077, CR-086)
# ─────────────────────────────────────────────────────────────
# **기본은 꺼짐이다.** 켜면 search-api가 `/api/v1/gh/*`를 열고 `prsctl`이 실행기
# (`gh-executor`, compose 프로파일 `github-operations`)를 함께 세운다. 두 서비스가 이
# 값을 **같이** 읽는다 — 한쪽만 켜지면 요청이 영원히 대기(`queued`)하거나 실행기가
# 아무것도 받지 않는다. 켜거나 끈 뒤에는 `prsctl upgrade`로 형상을 다시 세운다.
# 끄더라도 마이그레이션 028은 되돌리지 않는다 — 실행 이력은 남는다.
# 이 판이 여는 명령은 `gh pr list` 하나이며 전부 읽기 전용이다.
GH_OPERATIONS_ENABLED=false
#
# **자격은 넷으로 나뉜다.** 수집용 Data App(`GHE_APP_ID`) · 로그인용 OAuth App
# (`GHE_OAUTH_*`) · 표기용 App(`GHE_ANNOTATE_*`) · **Operations App**(아래). 서로 공유하지
# 않는다 (FR-GH-008 AC-1). 실행 권한은 이 App의 권한과 사용자 권한의 **교집합**이며,
# 사용자가 화면에서 직접 인가(위임)해야 실행이 시작된다. GHE에 GitHub App으로 등록한다:
# 권한 `Pull requests: Read`, callback `<서비스 주소>/gh/identity/callback`,
# 「Expire user authorization tokens」를 **켠다** (런북 7.C).
GHE_OPS_CLIENT_ID=
GHE_OPS_CLIENT_SECRET=
# 브라우저가 GHE에서 돌아올 주소 — `<서비스 주소>/gh/identity/callback`. App에 등록한
# 값과 문자 그대로 같아야 한다.
GHE_OPS_REDIRECT_URI=
# 위임 토큰 봉인 키(AES-256-GCM). `openssl rand -hex 32`로 만든 64자 hex.
# search-api와 gh-executor가 **같은 값**을 받는다 — 다르면 실행기가 모든 실행을
# `identity_unsealable`로 거절한다. 키를 바꾸면 기존 봉인을 풀 수 없으므로 사용자가
# 다시 연결해야 한다. 이 키는 비밀 저장소의 대체이지 동등물이 아니다(보안 문서 10.2).
GH_IDENTITY_VAULT_KEY=
# 동시 실행 수. 실행 큐의 파티션 4개를 이 수의 구독으로 나눠 맡는다 (상한은 파티션 수).
GH_EXECUTOR_MAX_CONCURRENT=2
# 레지스트리 검사(JOB-GH-003, CR-088) 주기(ms). 실행기가 기동 시 한 번, 그 뒤 이 주기로 설치된 gh의
# 인벤토리를 manifest와 대조하고 결과를 `gh_capability_verification`에 남긴다(웹 「운영 › gh 레지스트리」).
# 드리프트가 확인되면 다음 검사가 통과할 때까지 실행을 `registry_stale`로 거절한다. 기본 1일(86400000), 최소 1분.
GH_EXECUTOR_REGISTRY_CHECK_MS=86400000

# ─────────────────────────────────────────────────────────────
# 사내망 연동 — 프록시와 사설 CA
# ─────────────────────────────────────────────────────────────
# **사설 CA는 코드 변경 없이 성립한다.** Node 런타임이 이 변수를 직접 읽는다.
# CA 파일을 호스트에 두고 compose가 컨테이너 안 경로로 마운트한 뒤 그 경로를 적는다.
NODE_EXTRA_CA_CERTS=
#
# **`git`은 위 변수를 보지 않는다** (DEV-561). 미러 초기화(JOB-MIR-001)와 미러
# fetch는 `git`을 직접 부르므로 CA 경로를 따로 받는다. 위와 **같은 값**을 적는다
# (컨테이너 안 경로). 비워 두면 사설 CA를 쓰는 GHE에서 미러 초기화가
# `SSL certificate problem: unable to get local issuer certificate`로 실패하고
# 미러 볼륨이 빈 채로 남는다 — 그런데 다른 서비스는 Node가 CA를 읽으므로
# 정상으로 보인다.
GIT_SSL_CAINFO=
#
# **HTTP(S) 프록시는 아직 지원하지 않는다** (DEV-494). 방향이 반대인 같은 종류의
# 비대칭이다:
# `git` 서브프로세스는 `http_proxy`/`https_proxy` 환경 변수를 받지만,
# **Node 22의 `fetch`(undici)는 그것을 보지 않는다** — GHE REST와 OIDC 호출이
# 프록시를 거치지 않는다. 사내망이 프록시를 강제한다면 그 사실을 먼저 확인한 뒤
# `GitHubTransport`의 `fetchImpl` 주입 지점으로 최소 수정한다.
# **추측으로 설정 표면을 만들지 않는다.**
