# PR Search — 단일 호스트 운영 구성 (WP-070 / CR-059).
#
# **이 파일을 복사해 `.env`를 만든 뒤 값을 채운다.** 값이 채워진 파일은
# **저장소에도 어떤 오프라인 번들에도 들어가지 않는다** (보안 문서 6장, DEV-499) —
# 사내 시크릿 관리에서 주입하고 소유자만 읽도록 권한을 좁힌다.
#
#   chmod 600 .env
#
# `?:`로 표시된 값은 **없으면 기동하지 않는다.** 조용히 기본값으로 도는 것보다
# 배포가 잘못됐음을 말하는 편이 낫다.

# ─────────────────────────────────────────────────────────────
# 릴리스 신원 — `latest`를 쓰지 않는다 (DEV-491)
# ─────────────────────────────────────────────────────────────
# 반입한 번들의 `release-manifest.json`이 적은 값을 그대로 넣는다.
PRS_VERSION=

# ─────────────────────────────────────────────────────────────
# 노출 — 사용자 접점 둘만 호스트에 발행한다 (인프라 6장)
# ─────────────────────────────────────────────────────────────
# 리버스 프록시를 두지 않는 형상에서는 0.0.0.0이 사내망 전체에 열린다.
# 프록시나 방화벽이 앞에 있으면 127.0.0.1로 좁힌다.
WEB_BIND=0.0.0.0
WEB_PORT=3000
INGEST_BIND=0.0.0.0
INGEST_GATEWAY_PORT=3001

# ─────────────────────────────────────────────────────────────
# PostgreSQL — 주체를 둘로 나눈다 (마이그레이션 005)
# ─────────────────────────────────────────────────────────────
# 소유자: 마이그레이션이 DDL을 실행하는 주체.
POSTGRES_DB=prs
POSTGRES_OWNER_USER=prs
POSTGRES_OWNER_PASSWORD=

# 애플리케이션: DDL 권한이 없다. **감사 기록 불변성의 방어선이다** (FR-AUTH-004 AC-3).
#
# **`prs_app`을 그대로 쓰지 마라** (DEV-503). 그것은 마이그레이션 005가 만든
# `NOLOGIN` 그룹 롤이라 접속 자체가 거부된다. 로그인 가능한 주체를 만들고
# 멤버십을 준 뒤 **세션 기본 역할**을 그 롤로 둔다:
#
#   CREATE ROLE prs_app_login LOGIN PASSWORD :secret IN ROLE prs_app;
#   ALTER ROLE prs_app_login SET role = 'prs_app';
#
# 접속하면 `current_user = prs_app`이 된다. **소유자 계정을 그대로 쓰지 않는다** —
# 그 계정은 전권을 가져 감사 기록 불변성을 우회한다.
POSTGRES_APP_USER=prs_app_login
POSTGRES_APP_PASSWORD=

# `JOB-AUD-001` 파티션 수명 전용 (WP-039 / DEV-416).
# **`prs_admin`으로 직접 접속하지 않는다** — 그것은 `NOLOGIN` 그룹 롤이다.
# 로그인 가능한 주체를 만들고 멤버십을 준 뒤 잡이 `SET ROLE prs_admin`을 건다:
#   CREATE ROLE prs_retention LOGIN PASSWORD ...; GRANT prs_admin TO prs_retention;
# 없으면 **보존 잡만 서지 않는다.** 다만 다가올 파티션이 소진되면 INSERT가
# 전부 거부되므로 임시 상태여야 한다.
ADMIN_DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Elasticsearch — 파일럿은 single-node다 (CR-059)
# ─────────────────────────────────────────────────────────────
# 힙은 호스트 RAM의 절반 이하, 31GB 이하로 둔다.
ES_JAVA_OPTS=-Xms2g -Xmx2g

# ─────────────────────────────────────────────────────────────
# GitHub Enterprise
# ─────────────────────────────────────────────────────────────
GHE_BASE_URL=
# REST 진입점이 `<base>/api/v3`와 다르면 채운다.
GHE_API_URL=
# 없으면 `enrich`·`reconcile` 역할이 **기동을 거부한다.** search-api는 뜨되
# API-ADM-007을 등록하지 않고 기동 로그가 그 사실을 밝힌다 (DEV-177).
GHE_APP_ID=
# 개행은 `\n`으로 이스케이프해 한 줄로 넣는다.
GHE_APP_PRIVATE_KEY=
# `org:installationId` 쉼표 구분 (DEV-015).
GHE_INSTALLATIONS=
# 없으면 모든 웹훅이 401이다.
GHE_WEBHOOK_SECRET=
# 회전 중에만 채운다. 구·신 두 값으로 모두 검증한다.
GHE_WEBHOOK_SECRET_PREVIOUS=

# ─────────────────────────────────────────────────────────────
# 인증 (OIDC)
# ─────────────────────────────────────────────────────────────
AUTH_ENABLED=true
# TLS 없이 HTTP로 서비스하면 false여야 쿠키가 전달된다. **운영에서는 true다.**
SESSION_COOKIE_SECURE=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
# `그룹=역할` 쌍을 쉼표로 잇는다. 역할은 보안 문서 5.1의 여섯 중 하나다.
OIDC_GROUP_ROLE_MAP=

# ─────────────────────────────────────────────────────────────
# 검색
# ─────────────────────────────────────────────────────────────
# **없으면 기동하지 않는다** (ADR-010 Amendment). 최소 32자.
# 서명 없는 커서를 발급하는 대신 배포가 잘못됐음을 말한다 — 커서가 조용히
# 사라지면 사용자는 5만 건 구간을 끝까지 훑을 방법이 없어지는데, 그 실패는
# 오류가 아니라 "결과가 이게 전부"로 보인다.
SEARCH_CURSOR_HMAC_KEY=

# 지표 저장소 되질의 (DEV-029). 없으면 단계별 지연 항목만 `unavailable`이다.
METRICS_QUERY_URL=

# ─────────────────────────────────────────────────────────────
# 관리 API
# ─────────────────────────────────────────────────────────────
# `이름:토큰` 쌍을 쉼표로 잇는다. **이름이 감사 기록의 주체가 되므로 사람마다
# 다른 값을 준다** — 하나를 공유하면 "누가 했는가"에 답할 수 없다 (DEV-030).
#
# **OIDC 세션과 함께 구성할 수 없다** (DEV-048). 둘 다 있으면 search-api가
# 기동을 거부한다 — 세션 옆에 토큰 우회를 열어 둔 배포를 만들지 않는다.
# 세션이 서면 관리 API의 통제는 `operator` 역할이며 토큰 경로는 대체된다.
#
# 값이 있으면 `prsctl smoke`가 이 토큰으로 **실제 조회 왕복**을 검증한다.
ADMIN_API_TOKENS=

# ─────────────────────────────────────────────────────────────
# 수집·워커
# ─────────────────────────────────────────────────────────────
INGEST_SHUTDOWN_GRACE_MS=30000
INGEST_ENQUEUE_TIMEOUT_MS=150
# 곱한 값이 아카이브 볼륨 용량보다 작아야 한다 (FR-ING-010 AC-7).
INGEST_ARCHIVE_MAX_BYTES=67108864
INGEST_ARCHIVE_KEEP=5
BACKFILL_MAX_CONCURRENCY=2

# `prsctl restore`가 별칭 하나의 재색인을 기다리는 상한(초). 재색인은 전역 동시
# 실행 상한이 1이라 넷을 **하나씩** 돌리므로, 저장소가 크면 늘린다 (DEV-519).
# 셸에 같은 이름을 export하면 그 값이 이 파일보다 우선한다 (DEV-520).
PRS_REINDEX_TIMEOUT_S=3600
# blob 지연 인출 허용 여부 (OD-001 / DEV-111). 기본은 차단이다.
MIRROR_ALLOW_BLOB_FETCH=false

# ─────────────────────────────────────────────────────────────
# 사내망 연동 — 프록시와 사설 CA
# ─────────────────────────────────────────────────────────────
# **사설 CA는 코드 변경 없이 성립한다.** Node 런타임이 이 변수를 직접 읽는다.
# CA 파일을 호스트에 두고 compose가 컨테이너 안 경로로 마운트한 뒤 그 경로를 적는다.
NODE_EXTRA_CA_CERTS=
#
# **HTTP(S) 프록시는 아직 지원하지 않는다** (DEV-494). 비대칭이 있다:
# `git` 서브프로세스는 `http_proxy`/`https_proxy` 환경 변수를 받지만,
# **Node 22의 `fetch`(undici)는 그것을 보지 않는다** — GHE REST와 OIDC 호출이
# 프록시를 거치지 않는다. 사내망이 프록시를 강제한다면 그 사실을 먼저 확인한 뒤
# `GitHubTransport`의 `fetchImpl` 주입 지점으로 최소 수정한다.
# **추측으로 설정 표면을 만들지 않는다.**
