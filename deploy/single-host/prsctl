#!/usr/bin/env bash
#
# PR Search 단일 호스트 운영 도구 (WP-070 / CR-059 / ADR-021).
#
# **사내에서 실행한다.** 저장소 소스도 pnpm도 필요 없다 — 반입한 번들 안에서 돈다.
#
#   ./prsctl verify     번들 checksum 검증
#   ./prsctl load       이미지 tar 적재 (.env가 먼저 있어야 한다)
#   ./prsctl install    migration → ES mapping → up → health
#   ./prsctl upgrade    새 버전으로 교체 (migration 포함)
#   ./prsctl health     전 서비스 health 판정
#   ./prsctl smoke      read-only 검색 스모크
#   ./prsctl backup     PostgreSQL 논리 백업
#   ./prsctl restore    백업 복원 + 전량 재색인
#   ./prsctl lineage    이 형상이 어느 외부 커밋에서 왔는가
#   ./prsctl role list | grant <login|user_id> <역할> | revoke <login|user_id> <역할>
#                       관리자 지정 역할(operator·release_manager·security_officer)
#
# **fail-fast다.** checksum 불일치·이미지 부재·필수 환경 변수 부재·마이그레이션
# 실패·health 실패를 성공으로 접지 않는다.

set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUNDLE_ROOT="$(cd "${HERE}/../.." && pwd)"
ENV_FILE="${PRS_ENV_FILE:-${HERE}/.env}"
COMPOSE_FILE="${HERE}/compose.yml"
PROJECT="${PRS_PROJECT:-pr-search}"

die()  { printf '\033[31m오류:\033[0m %s\n' "$*" >&2; exit 1; }
step() { printf '\n\033[1m[%s] %s\033[0m\n' "$(date +%H:%M:%S)" "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }

# **GitHub Operations Plane은 `.env`가 켠다** (REL-007 R0 / WP-077, CR-086).
#
# `GH_OPERATIONS_ENABLED=true`면 `gh-executor`의 선택 프로파일을 함께 켠다. search-api와
# 실행기가 **같은 값**을 읽어야 하며 — 한쪽만 켜지면 요청이 영원히 `queued`이거나 실행기가
# 아무것도 받지 않는다 — 그 값을 여기서 프로파일로 옮기면 켜고 끄는 자리가 `.env` 하나가
# 된다. `require_env` 전에도 불리므로 파일이 없으면 프로파일 없이 돈다.
# **`.env`를 다시 파싱하지 않는다 — compose가 렌더한 값이 단일 근거다** (`DEV-664`). 처음에는 셸로
# `.env`를 읽었는데, 그 파서는 compose의 dotenv 규칙(감싼 따옴표·공백 뒤 주석·`export ` 접두·키 앞
# 공백·`=` 좌우 공백)과 갈렸고, 갈린 입력에서는 **search-api는 켜졌는데 실행기는 없는 형상**이 조용히
# 생겼다(실측). 그래서 search-api가 실제로 받을 값을 `docker compose config`의 렌더에서 읽는다 —
# 두 파서가 아니라 하나뿐이므로 갈릴 자리가 없다. 회귀(`runtime-reachability`)가 이 함수와 search-api의
# 판정을 키·값 양쪽 변형의 입력 표로 대조한다. 켜짐 판정(`gh_operations_state`)은 한 실행 안에서 한 번만
# 계산한다(캐시). 렌더 추출(`rendered_env_value`) 자체는 부를 때마다 렌더한다 — `$(…)` 서브셸 안에서 불리므로
# 셸 변수 캐시가 부모에 남지 않는다.
gh_operations_value() {
  rendered_env_value search-api GH_OPERATIONS_ENABLED
}

# **서비스가 실제로 받을 환경 변수 하나를 compose 렌더에서 읽는다** (DEV-664 · CR-091).
#
# 렌더는 YAML이므로 값이 인용될 수 있다 — 실측: `""`, `"true"`, `','`, `':'`, `'alice : tok'`. 큰따옴표와
# 작은따옴표 두 형식을 모두 벗긴다(작은따옴표 안의 `''`는 `'`, 큰따옴표 안의 `\"`·`\\`는 그 문자). 처음 판은
# 큰따옴표만 벗겼는데 GH 스위치는 그것으로 충분했고, 토큰 값에서 작은따옴표 렌더가 나왔다. `.env`가 없으면
# 빈 문자열이다(require_env 전에도 불린다).
rendered_env_value() {
  [ -f "$ENV_FILE" ] || return 0
  local rendered raw inner
  # **렌더를 먼저 변수에 받는다.** 파이프 끝에 `head -1`을 두면 앞 단계가 SIGPIPE로 끝날 수 있고, 이 스크립트는
  # `set -Eeuo pipefail`이라 그 비영 종료가 대입을 실패시켜 **빈 값으로** 떨어진다(독립 검토 B). 변수를 끝까지 읽는
  # `sed`에 넘기고 첫 줄은 셸이 자른다. 렌더가 실패하면(필수 변수 누락 등) 빈 값이다.
  rendered="$(docker compose --project-name "$PROJECT" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" config 2>/dev/null)" || return 0
  raw="$(printf '%s\n' "$rendered" \
    | sed -n "/^  $1:\$/,/^  [a-z][a-z0-9-]*:\$/p" \
    | sed -nE "s/^ +$2:[[:space:]]*(.*)\$/\\1/p")"
  raw="${raw%%$'\n'*}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  case "$raw" in
    \'*\')
      inner="${raw:1:${#raw}-2}"
      printf '%s' "${inner//\'\'/\'}" ;;
    \"*\")
      inner="${raw:1:${#raw}-2}"
      inner="${inner//\\\"/\"}"
      printf '%s' "${inner//\\\\/\\}" ;;
    *) printf '%s' "$raw" ;;
  esac
}

# **세션 인증과 관리 토큰을 함께 둔 형상을 기동 전에 막는다** (DEV-048 · CR-091 / DEV-696).
#
# search-api는 둘을 함께 받으면 기동을 거부한다(`OIDC 세션과 ADMIN_API_TOKENS를 함께 구성할 수 없다`). 그 거부는
# 옳지만 **컨테이너를 교체한 뒤에** 드러나 crash-loop로 보였다 — 사내 `0.1.0-pilot.6`에서 `AUTH_ENABLED=false`
# 파일럿을 `true`로 바꾸며 이전 `.env`의 토큰을 남긴 채 `upgrade`를 돌린 것이 그 모양이다. 판정은 search-api와
# 같다: 켜짐은 렌더된 `AUTH_ENABLED`가 정확히 `true`(compose가 기본값 `true`를 늘 렌더한다), 토큰은
# `parseAdminTokens`의 규칙(쉼표로 나누고 다듬어, `이름:` 뒤가 빈 항목은 토큰이 아니다). 회귀가 실제 compose로
# 입력 표를 대조한다.
admin_tokens_configured() {
  local raw="$1" entry token
  local -a entries=()
  IFS=',' read -r -a entries <<< "$raw"
  for entry in ${entries[@]+"${entries[@]}"}; do
    entry="${entry#"${entry%%[![:space:]]*}"}"; entry="${entry%"${entry##*[![:space:]]}"}"
    [ -n "$entry" ] || continue
    case "$entry" in *:*) token="${entry#*:}" ;; *) token="$entry" ;; esac
    token="${token#"${token%%[![:space:]]*}"}"; token="${token%"${token##*[![:space:]]}"}"
    [ -z "$token" ] || return 0
  done
  return 1
}
# search-api의 `parseAdminTokens`는 단수형 `ADMIN_API_TOKEN`도 읽지만 **compose가 그 키를 search-api에 넘기지 않으므로**
# 번들 형상에서는 늘 비어 있다. 그래서 복수형만 본다 — 회귀가 compose에 단수형이 생기는 순간 이 판단을 깨뜨린다.
auth_token_conflict() {
  [ "$(rendered_env_value search-api AUTH_ENABLED)" = true ] && admin_tokens_configured "$(rendered_env_value search-api ADMIN_API_TOKENS)"
}

# **평문 HTTP 세션을 허용한 형상인가** (CR-091 / DEV-694). 맞으면 경고 한 줄을 낸다 — 실패가 아니라 받아들인 위험이다.
# web의 판정(`insecureCookiesAllowed`)과 **같은 네 요소**를 렌더에서 본다: 운영(`NODE_ENV=production`) · 인증 켜짐
# (`AUTH_ENABLED=true`) · Secure 꺼짐(`SESSION_COOKIE_SECURE`가 `true`가 아니다 — web은 `true`만 Secure로 읽는다) ·
# `ALLOW_INSECURE_COOKIES=true`. 회귀가 실제 compose로 web의 판정과 대조한다.
insecure_cookie_notice() {
  [ "$(rendered_env_value web NODE_ENV)" = production ] || return 0
  [ "$(rendered_env_value web AUTH_ENABLED)" = true ] || return 0
  [ "$(rendered_env_value web SESSION_COOKIE_SECURE)" != true ] || return 0
  [ "$(rendered_env_value web ALLOW_INSECURE_COOKIES)" = true ] || return 0
  printf '  \033[33m!\033[0m 평문 HTTP 세션 허용 (ALLOW_INSECURE_COOKIES=true) — 파일럿 전용이다. TLS를 붙이면 SESSION_COOKIE_SECURE=true로 되돌리고 이 값을 지운다\n'
}
# **web의 세션 쿠키 계약을 컨테이너 교체 전에 판정한다** (CR-091 / DEV-694, 독립 검토 B). `ok` · `flag_invalid` ·
# `insecure_undeclared` 중 하나를 낸다. web(`resolveSessionReaderConfig`)과 같은 순서·요소다:
#   1. `ALLOW_INSECURE_COOKIES`가 다듬어서 `true`·`false`·빈 값이 아니면 거부 — web은 형상과 무관하게 먼저 던진다
#   2. 운영(`NODE_ENV=production`)이고 Secure가 꺼졌고(`SESSION_COOKIE_SECURE`가 `true`가 아님) 인증을 명시적으로
#      끄지 않았고(`AUTH_ENABLED`가 `false`가 아님) 플래그도 없으면 거부 — 사내 `0.1.0-pilot.6`이 교체 뒤에야 만난 형상
# 이 CR이 토큰 공존을 교체 전에 막으면서 자기가 만든 플래그의 오타는 교체 뒤로 미루면 같은 실패가 되살아난다.
# 회귀가 실제 compose로 web의 판정과 대조한다.
web_cookie_contract() {
  local flag
  flag="$(rendered_env_value web ALLOW_INSECURE_COOKIES)"
  flag="${flag#"${flag%%[![:space:]]*}"}"; flag="${flag%"${flag##*[![:space:]]}"}"
  case "$flag" in true|false|'') ;; *) printf 'flag_invalid'; return 0 ;; esac
  if [ "$(rendered_env_value web NODE_ENV)" = production ] \
     && [ "$(rendered_env_value web SESSION_COOKIE_SECURE)" != true ] \
     && [ "$(rendered_env_value web AUTH_ENABLED)" != false ] \
     && [ "$flag" != true ]; then
    printf 'insecure_undeclared'; return 0
  fi
  printf 'ok'
}

# on / off / reject — search-api·gh-executor의 `resolveOperationsEnabled`와 같은 분류다: `true`만 켜짐,
# 빈 값·`false`는 꺼짐, 그 밖(`TRUE`·`yes`…)은 두 서비스가 기동을 거부하므로 여기서도 거부한다.
GH_OPS_STATE=""
gh_operations_state() {
  if [ -z "$GH_OPS_STATE" ]; then
    case "$(gh_operations_value)" in
      true) GH_OPS_STATE=on ;;
      ''|false) GH_OPS_STATE=off ;;
      *) GH_OPS_STATE=reject ;;
    esac
  fi
  printf '%s' "$GH_OPS_STATE"
}
gh_operations_enabled() { [ "$(gh_operations_state)" = on ]; }

compose() {
  local profiles=()
  if gh_operations_enabled; then profiles+=(--profile github-operations); fi
  docker compose --project-name "$PROJECT" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" ${profiles[@]+"${profiles[@]}"} "$@"
}

# **애플리케이션 접속 주체를 만든다** (DEV-503 · DEV-510).
#
# `prs_app`은 마이그레이션 005가 만드는 `NOLOGIN` 그룹 롤이라 **그대로는 접속할 수
# 없다.** 로그인 가능한 주체에 그 멤버십을 주고 세션 기본 역할을 `prs_app`으로 둔다 —
# 접속하면 `current_user = prs_app`이 되고 감사 기록 불변성의 제약이 그대로 걸린다.
#
# **마이그레이션 뒤에 부른다.** `prs_app`이 그때 생기므로 그전에는 `GRANT`가 실패한다 —
# 런북이 설치 전 단계로 적어 두었던 것이 실행 불가능했던 이유다(DEV-510).
provision_app_role() {
  [ "$POSTGRES_APP_USER" != 'prs_app' ] || die \
    "POSTGRES_APP_USER가 'prs_app'이다 — 그것은 NOLOGIN 그룹 롤이라 접속할 수 없다 (DEV-503).
  'prs_app_login'처럼 다른 이름을 주면 이 명령이 만들고 멤버십까지 준다"
  printf '%s' "$POSTGRES_APP_USER" | grep -qE '^[a-z_][a-z0-9_]{0,62}$' \
    || die "POSTGRES_APP_USER가 PostgreSQL 식별자 형태가 아니다: $POSTGRES_APP_USER"

  step "애플리케이션 접속 주체 프로비저닝 — ${POSTGRES_APP_USER}"
  # 식별자는 바인딩할 수 없으므로 `format %I`로 조립해 `\gexec`가 실행한다.
  # 비밀번호는 psql 변수로 넘겨 셸·SQL 어느 쪽에도 리터럴로 남지 않는다.
  compose exec -T postgres psql -U "$POSTGRES_OWNER_USER" -d "$POSTGRES_DB" \
    -v ON_ERROR_STOP=1 -v role="$POSTGRES_APP_USER" -v pw="$POSTGRES_APP_PASSWORD" <<'SQL' >/dev/null \
    || die "접속 주체 프로비저닝 실패 — 애플리케이션이 인증에 실패한다"
SELECT format('CREATE ROLE %I LOGIN', :'role')
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'role')
\gexec
ALTER ROLE :"role" WITH LOGIN PASSWORD :'pw';
GRANT prs_app TO :"role";
ALTER ROLE :"role" SET role = 'prs_app';
SQL
  ok "${POSTGRES_APP_USER} → prs_app (세션 기본 역할)"
}

# **파티션을 만드는 주체가 없으면 수신이 통째로 막힌다** (DEV-556).
#
# `raw_event`는 파티션 테이블이고 **마이그레이션은 파티션을 만들지 않는다.** 그것을 만드는
# 것은 `JOB-AUD-001`뿐이며, 그 잡은 `ADMIN_DATABASE_URL`이 있어야 선다. 값이 비면 잡이 서지
# 않고, 다가올 파티션이 소진되는 순간 **모든 웹훅이 저장에서 거부된다** — 수신은 되는데
# 저장이 안 되는 모양이라 방화벽·서명 문제로 오진하기 쉽다. 첫 사내 반입(2026-09-07)에서
# 실제로 그렇게 됐다(DEV-553).
#
# 그때의 처방은 `.env.example`의 주석이었다. **주석은 강제하지 않는다** — 롤을 만드는 것도
# 사람 손에 남아 복구·재구축 때마다 다시 해야 했다. 여기가 `provision_app_role`과 같은
# 자리이므로 같은 방식으로 만든다.
provision_retention_role() {
  local url="$ADMIN_DATABASE_URL" rest creds role pw
  case "$url" in
    postgres://*|postgresql://*) ;;
    *) die "ADMIN_DATABASE_URL이 postgresql:// 형태가 아니다 — 파티션 수명 잡이 서지 못한다" ;;
  esac
  rest="${url#*://}"
  case "$rest" in *@*) ;; *) die "ADMIN_DATABASE_URL에 접속 주체가 없다 (postgresql://<롤>:<비밀번호>@<호스트>/<DB>)" ;; esac
  # **마지막 `@` 앞까지가 자격이다** — 비밀번호에 `@`가 있어도 견딘다.
  creds="${rest%@*}"
  case "$creds" in *:*) ;; *) die "ADMIN_DATABASE_URL에 비밀번호가 없다 — 이 롤은 LOGIN이어야 한다" ;; esac
  role="${creds%%:*}"
  pw="${creds#*:}"

  printf '%s' "$role" | grep -qE '^[a-z_][a-z0-9_]{0,62}$' \
    || die "ADMIN_DATABASE_URL의 롤 이름이 PostgreSQL 식별자 형태가 아니다: $role"
  [ "$role" != 'prs_admin' ] || die \
    "ADMIN_DATABASE_URL이 'prs_admin'으로 접속한다 — 그것은 NOLOGIN 그룹 롤이다.
  'prs_retention'처럼 다른 이름을 주면 이 명령이 만들고 멤버십까지 준다"
  # **비밀번호를 퍼센트 인코딩했으면 여기서 멈춘다.** 인코딩된 문자열로 롤을 만들면 앱이
  # 디코딩한 값으로 접속해 `password authentication failed`가 난다 — 사내에서 한 번 겪었다.
  case "$pw" in *%*) die "ADMIN_DATABASE_URL의 비밀번호에 '%'가 있다 — 퍼센트 인코딩은 지원하지 않는다. 인코딩이 필요 없는 비밀번호를 쓴다" ;; esac

  step "파티션 수명 잡 접속 주체 프로비저닝 — ${role}"
  compose exec -T postgres psql -U "$POSTGRES_OWNER_USER" -d "$POSTGRES_DB" \
    -v ON_ERROR_STOP=1 -v role="$role" -v pw="$pw" <<'SQL' >/dev/null \
    || die "파티션 수명 주체 프로비저닝 실패 — JOB-AUD-001이 서지 못하고 파티션이 소진되면 수신이 막힌다"
SELECT format('CREATE ROLE %I LOGIN', :'role')
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'role')
\gexec
ALTER ROLE :"role" WITH LOGIN PASSWORD :'pw';
GRANT prs_admin TO :"role";
SQL
  ok "${role} → prs_admin (JOB-AUD-001)"
}

require_env() {
  [ -f "$ENV_FILE" ] || die "$ENV_FILE 이 없다.
  최초 설치라면 .env.example을 복사해 값을 채운다.
  **업그레이드라면 이전 설치의 .env를 이 디렉터리로 복사하거나** (DEV-513)
  PRS_ENV_FILE=<이전 .env 경로>로 지정한다 — 번들은 값이 채워진 .env를 담지 않는다"
  # **값이 비어 있으면 기동하지 않는다.** 조용히 기본값으로 도는 것보다 낫다.
  local missing=()
  # **`ADMIN_DATABASE_URL`이 여기 있는 것은 선택이 아니어서다** (DEV-556). 비어 있으면
  # 파티션을 만드는 잡이 서지 않고, 소진되는 순간 모든 수신이 저장에서 거부된다.
  for key in PRS_VERSION POSTGRES_DB POSTGRES_OWNER_USER POSTGRES_OWNER_PASSWORD \
             POSTGRES_APP_USER POSTGRES_APP_PASSWORD GHE_BASE_URL GHE_WEBHOOK_SECRET \
             SEARCH_CURSOR_HMAC_KEY ADMIN_DATABASE_URL; do
    grep -qE "^${key}=.+" "$ENV_FILE" || missing+=("$key")
  done
  [ ${#missing[@]} -eq 0 ] || die "필수 값이 비어 있다: ${missing[*]}"
  # GitHub Operations Plane의 스위치가 두 서비스가 거부하는 값이면 여기서 먼저 막는다 (CR-086 / DEV-664).
  [ "$(gh_operations_state)" != reject ] \
    || die "GH_OPERATIONS_ENABLED는 true 또는 false여야 한다: '$(gh_operations_value)' — search-api·gh-executor가 기동을 거부한다"
  # 세션 인증과 관리 토큰의 공존은 search-api가 거부한다 — 컨테이너를 바꾸기 전에 말한다 (DEV-048 · DEV-696).
  ! auth_token_conflict \
    || die "AUTH_ENABLED=true(세션 인증)와 ADMIN_API_TOKENS를 함께 둘 수 없다 — search-api가 기동을 거부한다 (DEV-048).
  .env에서 ADMIN_API_TOKENS의 값을 비우고(ADMIN_API_TOKENS=) 다시 실행한다. 컨테이너는 아직 바꾸지 않았다.
  토큰으로 하던 운영 작업은 세션의 operator 역할로 한다: 그 사람이 한 번 로그인한 뒤 ./prsctl role grant <login> operator (RUNBOOK 6장)"
  # web의 세션 쿠키 계약도 컨테이너를 바꾸기 전에 말한다 (FR-AUTH-001 AC-2 · CR-091).
  case "$(web_cookie_contract)" in
    flag_invalid) die "ALLOW_INSECURE_COOKIES는 true 또는 false여야 한다: '$(rendered_env_value web ALLOW_INSECURE_COOKIES)' — web이 기동을 거부한다 (CR-091).
  컨테이너는 아직 바꾸지 않았다. .env의 값을 true나 false로 고치거나 비운다" ;;
    insecure_undeclared) die "운영에서 SESSION_COOKIE_SECURE=false만으로는 web이 기동하지 않는다 (FR-AUTH-001 AC-2). 컨테이너는 아직 바꾸지 않았다.
  셋 중 하나를 고른다: TLS를 붙이고 SESSION_COOKIE_SECURE=true · 로그인까지 시험하는 평문 HTTP 파일럿이면 ALLOW_INSECURE_COOKIES=true를 함께 적는다 ·
  로그인 없이 화면만 띄우려면 AUTH_ENABLED=false (RUNBOOK 6장)" ;;
  esac
  # **셸로 소싱하지 않는다.** `ES_JAVA_OPTS=-Xms2g -Xmx2g`처럼 값에 공백이 있으면
  # `. file`이 뒷부분을 명령으로 해석해 죽는다. Compose의 `.env` 파싱은 셸과 달라
  # 공백을 값의 일부로 보므로, 이 스크립트가 쓰는 몇 개만 같은 규칙으로 읽는다.
  env_value() { sed -nE "s/^$1=(.*)\$/\\1/p" "$ENV_FILE" | tail -1; }
  PRS_VERSION="$(env_value PRS_VERSION)"
  POSTGRES_DB="$(env_value POSTGRES_DB)"
  POSTGRES_OWNER_USER="$(env_value POSTGRES_OWNER_USER)"
  POSTGRES_APP_USER="$(env_value POSTGRES_APP_USER)"
  POSTGRES_APP_PASSWORD="$(env_value POSTGRES_APP_PASSWORD)"
  ADMIN_API_TOKENS="$(env_value ADMIN_API_TOKENS)"
  ADMIN_DATABASE_URL="$(env_value ADMIN_DATABASE_URL)"
  AUTH_ENABLED="$(env_value AUTH_ENABLED)"
  # **`.env`에서도 읽는다** (DEV-520). 런북이 "늘린다"고만 적어 두면 운영자는
  # 설치의 구성 파일에 넣는데, 그때 셸 환경만 보면 그 조정이 **조용히 무시된다.**
  # 셸에 명시한 값이 우선이다 — 한 번만 다르게 돌리는 경우를 막지 않는다.
  PRS_REINDEX_TIMEOUT_S="${PRS_REINDEX_TIMEOUT_S:-$(env_value PRS_REINDEX_TIMEOUT_S)}"
  PRS_REINDEX_TIMEOUT_S="${PRS_REINDEX_TIMEOUT_S:-3600}"
  # **자릿수까지 제한한다** (DEV-521). 숫자 형태만 보면 `9223372036854775807` 같은
  # 값이 통과하는데, 그러면 `$(date +%s) + timeout_s`가 **음수로 넘쳐** 상한이
  # 즉시 지난 것으로 판정된다 — 늘리려고 넣은 값이 **0초처럼 동작한다.**
  # 30일이면 `NFR-008`의 전량 재색인 목표(1,000만 문서 4시간)보다 180배 여유다.
  printf '%s' "$PRS_REINDEX_TIMEOUT_S" | grep -qE '^[1-9][0-9]{0,6}$' \
    || die "PRS_REINDEX_TIMEOUT_S는 1~9999999(약 115일) 범위의 정수여야 한다: $PRS_REINDEX_TIMEOUT_S"
  [ "$PRS_REINDEX_TIMEOUT_S" -le 2592000 ] \
    || die "PRS_REINDEX_TIMEOUT_S가 30일(2592000초)을 넘는다: $PRS_REINDEX_TIMEOUT_S"
  SEARCH_CURSOR_HMAC_KEY="$(env_value SEARCH_CURSOR_HMAC_KEY)"
  [ "${#SEARCH_CURSOR_HMAC_KEY}" -ge 32 ] || die "SEARCH_CURSOR_HMAC_KEY는 32자 이상이어야 한다 (ADR-010 Amendment)"
}

cmd_verify() {
  local sums="${BUNDLE_ROOT}/checksums/SHA256SUMS"
  [ -f "$sums" ] || die "checksum 파일이 없다: $sums"
  step "번들 checksum 검증"
  ( cd "$BUNDLE_ROOT" && sha256sum --quiet --check checksums/SHA256SUMS ) \
    || die "checksum 불일치 — 반입 파일이 변조되었거나 손상됐다. 설치를 멈춘다"
  ok "$(wc -l < "$sums")개 파일 전부 일치"
}

cmd_load() {
  # **`.env`가 먼저다** (DEV-524). 적재 뒤 `PRS_VERSION`의 이미지를 검증하려면 그 값을
  # 먼저 알아야 하고, 필수 구성의 부재는 **이미지 저장소를 바꾸기 전에** 말해야 한다 —
  # 이 검사가 `docker load` 뒤에 있으면 fail-fast가 아니다. 런북의 최초 설치 절차가
  # `load`를 `.env`보다 앞에 두어 두 번째 명령에서 멈추던 자리다.
  require_env
  step "이미지 적재"
  local tars=("${BUNDLE_ROOT}/images/pr-search-app.tar" "${BUNDLE_ROOT}/images/backing-services.tar")
  for tar in "${tars[@]}"; do
    [ -f "$tar" ] || die "이미지 tar이 없다: $tar"
    docker load -i "$tar" | sed 's/^/  /'
  done
  # **적재 뒤 실제로 있는지 확인한다.** compose가 pull을 시도하면 사내에서 실패한다.
  local missing=()
  for image in "prs/web:${PRS_VERSION}" "prs/search-api:${PRS_VERSION}" \
               "prs/ingest-gateway:${PRS_VERSION}" "prs/pipeline-worker:${PRS_VERSION}" \
               "prs/db:${PRS_VERSION}" "prs/es:${PRS_VERSION}" "prs/gh-executor:${PRS_VERSION}"; do
    docker image inspect "$image" >/dev/null 2>&1 || missing+=("$image")
  done
  [ ${#missing[@]} -eq 0 ] || die "적재 뒤에도 없는 이미지: ${missing[*]}"
  ok "이미지 전부 로컬에 있다 — compose가 pull하지 않는다"
}

cmd_install() {
  require_env
  step "구성 검사"
  compose config >/dev/null || die "compose 정의가 유효하지 않다"
  compose config | grep -qE 'image: .*:latest' && die "\`:latest\` 의존이 있다 — 릴리스 신원이 아니다 (DEV-491)"
  ok "compose 정의 유효 · \`:latest\` 의존 없음"

  step "백킹 서비스 기동"
  compose up -d postgres elasticsearch redis
  wait_healthy postgres elasticsearch redis

  step "데이터베이스 마이그레이션"
  compose --profile setup run --rm migrate || die "마이그레이션 실패 — 애플리케이션을 띄우지 않는다"
  ok "스키마 적용"

  provision_app_role
  provision_retention_role

  step "Elasticsearch 매핑·부트스트랩"
  compose --profile setup run --rm es-bootstrap || die "ES 매핑 적용 실패"
  ok "인덱스·별칭·ILM 적용"

  step "애플리케이션 기동"
  compose up -d
  cmd_health
}

cmd_upgrade() {
  require_env
  step "업그레이드 — ${PRS_VERSION}"
  compose config >/dev/null || die "compose 정의가 유효하지 않다"
  # **마이그레이션이 먼저다** (인프라 3장 배포 순서). 하위 호환이므로 옛 코드가
  # 새 스키마 위에서 돈다.
  compose --profile setup run --rm migrate || die "마이그레이션 실패 — 교체하지 않는다"
  # 비밀번호가 회전됐을 수 있으므로 업그레이드마다 다시 맞춘다. 멱등이다.
  provision_app_role
  provision_retention_role
  compose --profile setup run --rm es-bootstrap || die "ES 매핑 적용 실패"
  compose up -d
  cmd_health
}

wait_healthy() {
  local deadline=$(( $(date +%s) + 300 ))
  for svc in "$@"; do
    printf '  %s ' "$svc"
    while :; do
      local cid state
      cid="$(compose ps -q "$svc" 2>/dev/null || true)"
      if [ -n "$cid" ]; then
        state="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || echo unknown)"
        case "$state" in
          healthy|running) printf '\033[32m%s\033[0m\n' "$state"; break ;;
          exited|dead)     printf '\033[31m%s\033[0m\n' "$state"; die "$svc 가 죽었다" ;;
        esac
      fi
      [ "$(date +%s)" -lt "$deadline" ] || { printf '\033[31mtimeout\033[0m\n'; die "$svc 가 준비되지 않았다"; }
      printf '.'; sleep 5
    done
  done
}

cmd_health() {
  require_env
  step "health 판정"
  local failed=0

  # 백킹 서비스는 컴포즈 healthcheck가 정본이다.
  for svc in postgres elasticsearch redis; do
    local cid state
    cid="$(compose ps -q "$svc" 2>/dev/null || true)"
    state="$([ -n "$cid" ] && docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || echo absent)"
    if [ "$state" = healthy ] || [ "$state" = running ]; then ok "$svc ($state)"; else bad "$svc ($state)"; failed=1; fi
  done

  # 애플리케이션은 자기 `/healthz`가 정본이다 (인프라 3장).
  # **컨테이너 안에서 부른다** — 호스트에 발행하지 않는 포트가 있기 때문이다.
  for pair in "search-api:3002" "ingest-gateway:3001" "web:3000"; do
    local svc="${pair%%:*}" port="${pair##*:}" body
    # **`127.0.0.1`이지 `localhost`가 아니다.** alpine에서 `localhost`는 `::1`로 먼저
    # 해석되는데 Fastify 기본 바인딩은 IPv4라 `wget`이 곧바로 거부된다 — 서비스는
    # 멀쩡한데 health만 빨갛게 보인다.
    if body="$(compose exec -T "$svc" wget -qO- "http://127.0.0.1:${port}/healthz" 2>/dev/null)"; then
      case "$body" in *'"status":"ok"'*) ok "$svc /healthz — $body" ;; *) bad "$svc /healthz — $body"; failed=1 ;; esac
    else
      bad "$svc /healthz 응답 없음"; failed=1
    fi
  done

  # **평문 HTTP 세션을 허용한 형상은 health마다 말한다** (CR-091 / DEV-694). 실패가 아니다 — 받아들인 위험이다.
  # web이 기동마다 같은 경고를 로그에 남기지만, 운영자가 가장 자주 보는 출력이 이것이다.
  insecure_cookie_notice

  # **GitHub Operations Plane은 켰을 때만 실재해야 하고, 껐으면 없어야 한다** (CR-086).
  # 프로파일 밖의 컨테이너가 떠 있으면 `.env`와 형상이 갈린 것이다 — 그 상태의 실행기는
  # 봉인 키가 다를 수 있고, 그러면 모든 실행이 `identity_unsealable`로 거절된다.
  local ghx_cid
  ghx_cid="$(docker ps -q -f "label=com.docker.compose.project=${PROJECT}" -f "label=com.docker.compose.service=gh-executor" 2>/dev/null || true)"
  if gh_operations_enabled; then
    local body
    if body="$(compose exec -T gh-executor wget -qO- "http://127.0.0.1:3004/healthz" 2>/dev/null)"; then
      case "$body" in
        *'"status":"ok"'*'"execution":"enabled"'*) ok "gh-executor /healthz — $body" ;;
        *) bad "gh-executor /healthz — $body (execution이 enabled가 아니거나 백킹 서비스 확인 실패)"; failed=1 ;;
      esac
    else
      bad "gh-executor /healthz 응답 없음 — GH_OPERATIONS_ENABLED=true인데 실행기가 서지 않았다"; failed=1
    fi
  elif [ -n "$ghx_cid" ]; then
    bad "gh-executor가 떠 있는데 GH_OPERATIONS_ENABLED가 true가 아니다 — .env와 형상이 갈렸다 (prsctl upgrade로 다시 세운다)"; failed=1
  else
    ok "gh-executor 없음 (GH_OPERATIONS_ENABLED 꺼짐 — 의도한 형상)"
  fi

  # 워커는 인바운드를 받지 않으므로 프로세스 상태와 기동 로그로 본다.
  for svc in worker-enrich worker-project worker-sequence worker-link worker-mirror \
             worker-reconcile worker-batch worker-authz worker-release; do
    local cid state
    cid="$(compose ps -q "$svc" 2>/dev/null || true)"
    state="$([ -n "$cid" ] && docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || echo absent)"
    if [ "$state" = running ]; then ok "$svc ($state)"; else bad "$svc ($state)"; failed=1; fi
  done

  [ $failed -eq 0 ] || die "health 판정 실패 — 위 항목을 확인하라"
  printf '\n전 서비스 정상\n'
}

cmd_smoke() {
  require_env
  step "read-only 조회 스모크"

  # **health는 스모크가 아니다** (DEV-515). 이전 판은 `/healthz` 둘과 별칭 존재만
  # 보고 "검색 스모크 통과"라고 말했는데, 그 셋이 전부 초록이어도 **라우팅·인증
  # 배선·질의 구성·결과 디코딩이 통째로 깨져 있을 수 있다.** 실제 조회 왕복을 건다.

  local failed=0
  for pair in "web:3000" "search-api:3002"; do
    local svc="${pair%%:*}" port="${pair##*:}" code
    code="$(compose exec -T "$svc" wget -qO- --server-response "http://127.0.0.1:${port}/healthz" 2>&1 \
      | awk '/HTTP\//{print $2}' | tail -1 || true)"
    if [ "$code" = 200 ]; then ok "$svc /healthz"; else bad "$svc /healthz → ${code:-무응답}"; failed=1; fi
  done

  # ── 사람이 여는 화면 ───────────────────────────────────────
  #
  # **`/healthz`는 화면이 아니다** (`DEV-577`). `web`의 헬스체크는 라우트 하나이며,
  # 구성이 잘못돼도 그것만 200을 내던 시절이 있었다 — 사내 반입 `0.1.0-pilot.3`이
  # 그 상태로 초록이었고 사람이 여는 화면만 전부 500이었다. 진입 화면을 실제로
  # 요청한다.
  #
  # **200을 요구하지 않는다.** 인증을 켠 배포에서 이 경로는 로그인으로 리다이렉트
  # (3xx)하는 것이 정상이다. 여기서 거르는 것은 **5xx**다.
  #
  # **첫 상태 줄을 읽는다.** busybox `wget`에는 `--max-redirect`가 없어 리다이렉트를
  # 따라가는데, 인증을 켠 배포에서 그 끝은 사내 IdP다 — 여기서 IdP에 닿는지는 이
  # 검사의 관심사가 아니다. 첫 줄이 `/` 자신의 답이다 (`tail`이면 IdP 왕복의 답을
  # 읽는다).
  local entry
  entry="$(compose exec -T web wget -qO/dev/null --server-response \
    'http://127.0.0.1:3000/' 2>&1 | awk '/HTTP\//{print $2}' | head -1 || true)"
  case "$entry" in
    5*|'') bad "웹 진입 화면 / → ${entry:-무응답} — 헬스체크가 초록이어도 사람은 쓸 수 없다 (DEV-577)"; failed=1 ;;
    *) ok "웹 진입 화면 / → ${entry}" ;;
  esac

  # 엔티티 별칭 — 매핑 부트스트랩의 결과다.
  local aliases
  aliases="$(compose exec -T elasticsearch curl -fsS 'http://localhost:9200/_cat/aliases?h=alias' 2>/dev/null \
    | tr -d '\r' | sort | tr '\n' ' ' || true)"
  case "$aliases" in
    *prs-pull-requests*) ok "ES 별칭: $aliases" ;;
    *) bad "ES 별칭에 prs-pull-requests가 없다 — 매핑 부트스트랩이 서지 않았다"; failed=1 ;;
  esac

  # ── 실제 조회 왕복 ─────────────────────────────────────────
  #
  # 관리 토큰이 있으면 그것으로 건다. **`/search`는 세션 인증을 요구하고**
  # 세션은 사내 OIDC를 요구하므로 외부망에서 실행할 수 없다 — 그 사실을
  # 통과로 적지 않고 NOT RUN으로 남긴다.
  if [ -n "${ADMIN_API_TOKENS:-}" ]; then
    local token="${ADMIN_API_TOKENS%%,*}"
    token="${token#*:}"
    local body
    # PostgreSQL 왕복: 라우팅 → 토큰 인증 → 질의 → 응답 디코딩
    # **`|| true`가 없으면 `set -e`가 진단 앞에서 스크립트를 죽인다.** 401이든
    # 무응답이든 종료 코드는 1이고, 그 상태로 끝나면 운영자는 **무엇이 실패했는지
    # 듣지 못한다** — 실패를 말하지 않는 실패는 성공으로 접는 것과 같다.
    body="$(compose exec -T search-api wget -qO- --header="Authorization: Bearer ${token}" \
      'http://127.0.0.1:3002/api/v1/admin/repositories?limit=1' 2>/dev/null || true)"
    case "$body" in
      *'"items"'*'"total"'*) ok "조회 왕복 (PostgreSQL) — /api/v1/admin/repositories" ;;
      '') bad "조회 왕복 (PostgreSQL) 무응답 — 인증 또는 라우팅이 깨졌다"; failed=1 ;;
      *) bad "조회 왕복 (PostgreSQL) 응답이 예상 모양이 아니다: $(printf '%.120s' "$body")"; failed=1 ;;
    esac
    # Elasticsearch 왕복: 색인 상태를 실제로 읽는다
    body="$(compose exec -T search-api wget -qO- --header="Authorization: Bearer ${token}" \
      'http://127.0.0.1:3002/api/v1/admin/reindex' 2>/dev/null || true)"
    case "$body" in
      *'"correlation_id"'*) ok "조회 왕복 (Elasticsearch) — /api/v1/admin/reindex" ;;
      '') bad "조회 왕복 (Elasticsearch) 무응답"; failed=1 ;;
      *) bad "조회 왕복 (Elasticsearch) 응답이 예상 모양이 아니다: $(printf '%.120s' "$body")"; failed=1 ;;
    esac
  else
    printf '  \033[33m—\033[0m 조회 왕복: NOT RUN — ADMIN_API_TOKENS가 없다\n'
  fi

  # `/search`는 세션 인증 뒤에 있다 (ADR-011). 사내 OIDC 없이는 실행할 수 없다.
  if [ "${AUTH_ENABLED:-true}" = 'false' ]; then
    printf '  \033[33m—\033[0m /search: NOT RUN — AUTH_ENABLED=false면 검색 라우트가 등록되지 않는다\n'
  else
    printf '  \033[33m—\033[0m /search: NOT RUN — internal environment required (사내 OIDC 세션 필요)\n'
  fi

  # 워커 역할이 실제로 기동 로그에 나타나는지 (CR-034의 도달성 규율).
  local roles_seen=0 roles_total=0
  for svc in $(compose config --services | grep '^worker-'); do
    roles_total=$((roles_total + 1))
    compose logs --tail 200 "$svc" 2>/dev/null | grep -q 'roles:' && roles_seen=$((roles_seen + 1))
  done
  if [ "$roles_seen" -eq "$roles_total" ] && [ "$roles_total" -gt 0 ]; then
    ok "워커 기동 로그 ${roles_seen}/${roles_total}"
  else
    bad "워커 기동 로그 ${roles_seen}/${roles_total} — 로그에서 역할을 확인하지 못한 워커가 있다"
    failed=1
  fi

  [ $failed -eq 0 ] || die "스모크 실패 — 위 항목을 확인하라"
  printf '\n스모크 통과\n'
}

cmd_backup() {
  require_env
  local dir="${PRS_BACKUP_DIR:-${HERE}/backups}"
  mkdir -p "$dir"
  local out="${dir}/prs-$(date +%Y%m%d-%H%M%S).dump"
  step "PostgreSQL 논리 백업 — $out"
  # **`pg_dump`다.** 실행 중 데이터 디렉터리 파일 복사는 일관성이 없다 (인프라 9.4장).
  # Elasticsearch·Redis·미러·아카이브는 백업하지 않는다 — 전부 재구성 가능하다.
  compose exec -T postgres pg_dump -U "$POSTGRES_OWNER_USER" -d "$POSTGRES_DB" -Fc > "$out" \
    || { rm -f "$out"; die "백업 실패"; }
  sha256sum "$out" > "${out}.sha256"
  ok "$(du -h "$out" | cut -f1) · checksum 기록"
  printf '\n**Elasticsearch는 백업하지 않는다** — PostgreSQL에서 재색인해 복구한다 (ADR-004).\n'
}

cmd_restore() {
  require_env
  local file="${1:?사용법: prsctl restore <백업 파일>}"
  [ -f "$file" ] || die "백업 파일이 없다: $file"
  if [ -f "${file}.sha256" ]; then
    sha256sum --quiet --check "${file}.sha256" || die "백업 checksum 불일치 — 복원하지 않는다"
    ok "백업 checksum 일치"
  fi
  step "복원 — 애플리케이션을 먼저 멈춘다"
  # 실행기도 멈춘다 — 복원 중인 DB에서 실행을 집으면 안 된다. 프로파일이 꺼져 있으면 목록에 없다.
  compose stop web search-api ingest-gateway $(compose config --services | grep -E '^(worker-|gh-executor$)') >/dev/null
  step "PostgreSQL 복원 — 데이터베이스를 다시 만든다"
  #
  # **`pg_restore --clean`을 쓰지 않는다.** 이 스키마는 `raw_event`·`audit_record`가
  # 파티션 테이블이고 그 파티션의 제약은 **부모에서 상속된 것**이라 개별로 드롭할 수
  # 없다 — `--clean`이 `DROP CONSTRAINT`를 시도하다 파티션 수만큼 오류를 내고
  # `errors ignored on restore`로 끝난다. **일부만 복원된 상태를 성공으로 접지 않는다.**
  # 빈 데이터베이스에 복원하는 것이 파티션 스키마에서 유일하게 결정적인 경로다.
  compose exec -T postgres psql -U "$POSTGRES_OWNER_USER" -d postgres -v ON_ERROR_STOP=1 -c \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${POSTGRES_DB}' AND pid <> pg_backend_pid()" >/dev/null \
    || die "기존 연결을 끊지 못했다"
  compose exec -T postgres psql -U "$POSTGRES_OWNER_USER" -d postgres -v ON_ERROR_STOP=1 \
    -c "DROP DATABASE IF EXISTS ${POSTGRES_DB}" -c "CREATE DATABASE ${POSTGRES_DB} OWNER ${POSTGRES_OWNER_USER}" >/dev/null \
    || die "데이터베이스를 다시 만들지 못했다"
  compose exec -T postgres pg_restore -U "$POSTGRES_OWNER_USER" -d "$POSTGRES_DB" --exit-on-error < "$file" \
    || die "복원 실패 — 데이터베이스가 비어 있다. 백업 파일을 확인하라"
  ok "스키마·데이터 복원"

  # **마이그레이션을 다시 적용한다** (DEV-514). 백업이 현재 릴리스보다 이전이면
  # 복원된 스키마도 그 시점의 것이고, 현재 코드가 없는 열·표를 읽다 죽는다.
  # 설치·업그레이드가 이미 하는 일을 복구 경로만 빠뜨리고 있었다.
  step "마이그레이션 재적용 — 백업이 현재 릴리스보다 이전일 수 있다"
  compose --profile setup run --rm migrate || die "마이그레이션 실패 — 애플리케이션을 띄우지 않는다"
  provision_app_role
  provision_retention_role

  # **파생 색인을 비우고 다시 만든다** (DEV-511).
  #
  # 복원한 정본보다 **새로운 문서가 색인에 남아 있으면** 검색이 정본에 없는 것을
  # 답한다 — 되돌린 데이터가 조회로 되살아나는 것이며, 매핑만 다시 적용하는
  # `es-bootstrap`은 기존 인덱스를 그대로 둔다. 비어 있는 색인이 **틀린 색인보다
  # 낫다**: 전자는 "아직 없다"이고 후자는 거짓이다 (ADR-004).
  step "파생 색인 삭제 — 정본에 없는 문서를 답하지 않는다"
  local indices
  indices="$(compose exec -T elasticsearch curl -fsS \
    'http://localhost:9200/_cat/indices/prs-pull-requests*,prs-commits*,prs-links*,prs-releases*?h=index&ignore_unavailable=true' \
    2>/dev/null | tr -d '\r' | tr '\n' ',' | sed 's/,\+/,/g; s/^,//; s/,$//')"
  if [ -n "$indices" ]; then
    # 와일드카드로 지우지 않는다 — ES 8의 `destructive_requires_name`이 막고,
    # 이름을 세어 두어야 무엇을 지웠는지 로그가 말한다.
    compose exec -T elasticsearch curl -fsS -XDELETE "http://localhost:9200/${indices}" >/dev/null \
      || die "파생 색인을 지우지 못했다 — 낡은 문서가 남은 채 서비스를 띄우지 않는다"
    ok "삭제: ${indices}"
  else
    ok "지울 엔티티 색인이 없다"
  fi

  step "Elasticsearch 매핑 재적용"
  compose --profile setup run --rm es-bootstrap || die "ES 매핑 적용 실패"

  step "애플리케이션 재기동"
  compose up -d
  cmd_health

  # **재색인을 하나씩 끝까지 돌린다** (DEV-519).
  #
  # `enqueueReindex`는 **전역 동시 실행 상한이 1이다** — 다른 별칭이 도는 중이면
  # `busy`를 돌려준다(재색인이 클러스터를 통째로 쓰기 때문이며 의도된 계약이다).
  # 그래서 넷을 연달아 예약하면 **첫 하나만 서고 나머지 셋은 거절된다.** 그런데
  # 위에서 **넷을 모두 지웠으므로**, 그 상태로 끝내면 커밋·간선·릴리스 색인이
  # **빈 채로 서비스된다.** 실패를 출력만 하고 성공으로 끝내지 않는다.
  #
  # 하나를 예약하고 **끝날 때까지 기다린 뒤** 다음을 예약한다. 상한은
  # `PRS_REINDEX_TIMEOUT_S`가 정하며, 넘기면 **남은 별칭을 이름으로 말하고
  # 종료 코드 1을 낸다** — 절반만 선 상태를 완료로 보고하지 않는다.
  step "전량 재색인 (JOB-ING-006) — 동시 실행 상한이 1이라 하나씩 돌린다"
  local timeout_s="$PRS_REINDEX_TIMEOUT_S"
  local pending=() alias
  for alias in prs-pull-requests prs-commits prs-links prs-releases; do
    printf '  %s ' "$alias"
    if ! compose --profile setup run --rm reindex node dist/reindex-cli.js --alias "$alias" >/dev/null 2>&1; then
      printf '\033[31m예약 실패\033[0m\n'; pending+=("$alias"); continue
    fi
    local deadline=$(( $(date +%s) + timeout_s )) state=''
    while :; do
      state="$(compose exec -T postgres psql -U "$POSTGRES_OWNER_USER" -d "$POSTGRES_DB" -tAc \
        "SELECT state FROM job WHERE type='reindex' AND target='${alias}' ORDER BY job_id DESC LIMIT 1" \
        2>/dev/null | tr -d '[:space:]' || true)"
      case "$state" in
        completed) printf '\033[32m완료\033[0m\n'; break ;;
        failed|cancelled) printf '\033[31m%s\033[0m\n' "$state"; pending+=("$alias"); break ;;
      esac
      if [ "$(date +%s)" -ge "$deadline" ]; then
        printf '\033[31m시간 초과(%ss)\033[0m\n' "$timeout_s"; pending+=("$alias"); break
      fi
      printf '.'; sleep 10
    done
  done

  if [ ${#pending[@]} -gt 0 ]; then
    printf '\n'
    bad "재색인이 끝나지 않은 별칭: ${pending[*]}"
    die "**그 색인은 지금 비어 있다.** 운영 콘솔의 재색인 화면에서 남은 것을 실행하라 — 정본은 PostgreSQL이다 (ADR-004).
  오래 걸리는 것이 원인이면 PRS_REINDEX_TIMEOUT_S를 늘려 다시 실행한다"
  fi
  ok "재색인 4/4 완료"
  printf '\n복구가 끝났다. 검색이 복원된 정본을 답한다.\n'
}

# **관리자 지정 역할** (CR-091 / DEV-695).
#
# `operator`·`release_manager`·`security_officer`는 IdP 그룹·GHE 팀으로 줄 수 없고(CR-015) `app_user.roles[]`에만
# 있다. 세션 인증을 켠 배포에서 그 값을 바꾸는 경로가 이것 하나다 — 최초의 operator는 화면으로 만들 수 없다.
# search-api 이미지로 한 번 실행하므로 search-api와 같은 DB 접속 구성을 쓰고, 변경과 감사를 한 트랜잭션에 남긴다.
# **행위 주체는 호스트 사용자다.** sudo로 돌렸으면 sudo를 부른 사람이다. 감사 기록에는 `prsctl:<사용자>`로 남는다.
cmd_role() {
  require_env
  local actor
  actor="$(printf '%s' "${SUDO_USER:-$(id -un)}" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-64)"
  [ -n "$actor" ] || die "호스트 사용자 이름을 알 수 없다 — 감사 기록의 행위 주체 없이 역할을 바꾸지 않는다"
  local status=0
  compose run --rm --no-deps -T search-api node dist/role-cli.js "$@" --actor "$actor" || status=$?
  return "$status"
}

cmd_lineage() {
  local m="${BUNDLE_ROOT}/manifest/release-manifest.json"
  [ -f "$m" ] || die "release-manifest.json이 없다: $m"
  step "이 형상의 계보"
  cat "$m"
}

case "${1:-}" in
  verify)  cmd_verify ;;
  load)    cmd_verify; cmd_load ;;
  install) cmd_install ;;
  upgrade) cmd_upgrade ;;
  health)  cmd_health ;;
  smoke)   cmd_smoke ;;
  backup)  cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  lineage) cmd_lineage ;;
  role)    shift; cmd_role "$@" ;;
  *) sed -n '2,27p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
