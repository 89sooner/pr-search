# 개행 정책 (WP-070).
#
# 이 저장소의 커밋된 blob은 LF이고 작업 트리는 전역 `core.autocrlf` 때문에 CRLF다.
# 대부분의 파일에는 문제가 없지만 **실행되는 스크립트는 다르다** — 리눅스 커널이
# `#!/usr/bin/env bash\r`을 해석하지 못해 `bad interpreter`로 죽는다. 사내 호스트에
# 반입된 뒤에야 드러나면 고칠 방법이 그 자리에 없다.
*.sh text eol=lf
deploy/single-host/prsctl text eol=lf

# Compose·Filebeat 설정도 컨테이너 안에서 읽힌다. LF로 고정한다.
*.yml text eol=lf
*.yaml text eol=lf

# `.env.example`은 사내에서 `cp`로 `.env`가 되고 `prsctl`이 줄 단위로 읽는다. CRLF면
# 모든 값 끝에 `\r`이 붙어 `3600` 같은 멀쩡한 값이 거부된다 (DEV-526). 런북도 번들에
# 들어가는 텍스트라 함께 고정한다.
deploy/single-host/.env.example text eol=lf
deploy/single-host/RUNBOOK.md text eol=lf

# 회귀가 PATH에 두고 실제로 실행하는 대역이다. 확장자가 없어 위의 `*.sh`에 걸리지
# 않으므로 여기서 고정한다 — CRLF가 되면 `#!/usr/bin/env bash\r`이 되어 CI에서
# `bad interpreter`로 죽는다 (DEV-541의 시험이 여기에 의존한다).
regression/fixtures/release-tag/fake-gh text eol=lf
regression/fixtures/release-tag/fake-docker text eol=lf

# **이미지 빌드 안에서 도는 스크립트다** (DEV-551). `scripts/lint-deps.mjs`와 파일 모양은
# 같지만 그것은 CI에서만 돌고 이것은 배포 이미지로 들어간다 — 위의 `*.yml`을 고정하는
# 것과 같은 이유다. `Dockerfile`이 `node <path>`로 부르므로 CRLF여도 지금은 돈다(실측).
# 고정하는 것은 그 사실이 바뀔 때의 대가 때문이다: 셔뱅을 가진 파일이라 실행 비트가
# 붙거나 호출 방식이 바뀌면 `node\r`로 죽고, 그때는 이미 이미지 안이다.
scripts/materialize-turbopack-externals.mjs text eol=lf
