  "common": {
    "transport": "private 리스너의 mTLS만. TLS를 끝내는 프록시와 전달 헤더는 지원하지 않는다(L4 passthrough만)",
    "response_headers": {
      "Cache-Control": "private, no-store",
      "Pragma": "no-cache",
      "X-Content-Type-Options": "nosniff",
      "X-Correlation-Id": "서버가 만든 UUID"
    },
    "cookie_header": "400 INVALID_REQUEST",
    "duplicate_query_key": "400 INVALID_REQUEST",
    "unknown_query_key": "400 INVALID_REQUEST",
    "head_options_unlisted_path": "404 NOT_FOUND (등록되지 않은 client는 401 CLIENT_AUTH_FAILED가 먼저)",
    "rate_limit": "pr-search에는 없다 — 사용자·client별 제한과 동시성 상한은 PIPE BFF가 둔다(CONTRACT_DIFF D-14)",
    "limits": {
      "request_timeout_ms": 60000,
      "body_bytes_max": 16384
    },
    "permission_unavailable": "503 PERMISSION_UNAVAILABLE은 조회마다 봉투가 다르다. 저장소 목록·발급은 연동 봉투(retryable: true)로, 나머지 조회는 원본 실행 함수가 잡아 원본 봉투(retryable 키 없음)로 낸다. BFF는 두 봉투 모두 error.code로 처리한다. 각 조회의 integration_error_codes에 이 코드가 있는지가 곧 연동 봉투로 나오는지다(통합 시험 openapi.test.ts가 실측으로 대조한다)"
  },
