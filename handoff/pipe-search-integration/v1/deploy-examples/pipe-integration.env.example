# PIPE 연동 private 리스너 (CR-112) — 예시다. 실제 값은 운영 담당이 정한다.
# 비밀 파일(키·인증서)은 secret 저장소에서 마운트하고 이 파일에 내용을 적지 않는다.

PIPE_SEARCH_INTEGRATION_ENABLED=false

# 컨테이너 안 바인드. 외부 노출은 compose override의 ports가 private 인터페이스로만 한다.
PIPE_SEARCH_INTEGRATION_HOST=0.0.0.0
PIPE_SEARCH_INTEGRATION_PORT=3443

PIPE_SEARCH_INTEGRATION_TLS_KEY_FILE=/run/secrets/pipe-integration/server.key.pem
PIPE_SEARCH_INTEGRATION_TLS_CERT_FILE=/run/secrets/pipe-integration/server.crt.pem
PIPE_SEARCH_INTEGRATION_TLS_CLIENT_CA_FILE=/run/secrets/pipe-integration/pipe-client-ca.pem
PIPE_SEARCH_INTEGRATION_POLICY_FILE=/run/secrets/pipe-integration/policy.json

# 호스트 쪽 private 인터페이스 (compose override가 읽는다)
PIPE_INTEGRATION_BIND=<private-interface-ip>
PIPE_INTEGRATION_PUBLISHED_PORT=3443
PIPE_INTEGRATION_SECRETS_DIR=/etc/prs/pipe-integration
